{
    "name": "ripple/ripple",
    "description": "A code change impact analyzer that helps developers understand how far their code changes can travel before merging.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "php",
        "static-analysis",
        "code-analysis",
        "dependency-graph",
        "impact-analysis",
        "github",
        "pull-request",
        "developer-tools",
        "laravel",
        "risk-analysis",
        "code-quality"
    ],
    "authors": [
        {
            "name": "Milad Fathi",
            "email": "miladfathi021@gmail.com"
        }
    ],
    "homepage": "https://github.com/miladfathi021/Ripple",
    "support": {
        "issues": "https://github.com/miladfathi021/Ripple/issues",
        "source": "https://github.com/miladfathi021/Ripple"
    },
    "require": {
        "php": "^8.3",
        "nikic/php-parser": "^5.4",
        "symfony/console": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Ripple\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ripple\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/ripple"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
